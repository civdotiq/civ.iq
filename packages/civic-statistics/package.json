{
  "name": "@civiq/civic-statistics",
  "version": "0.1.2",
  "description": "Civic data statistics utilities — correlation, peer comparison, confidence scoring with civic-domain defaults",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "METHODOLOGY.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build && npm run test"
  },
  "dependencies": {
    "simple-statistics": "^7.8.0"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  },
  "license": "MIT",
  "author": "Mark Sandford",
  "homepage": "https://github.com/civdotiq/civ.iq/tree/main/packages/civic-statistics#readme",
  "bugs": {
    "url": "https://github.com/civdotiq/civ.iq/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/civdotiq/civ.iq.git",
    "directory": "packages/civic-statistics"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "civic",
    "statistics",
    "correlation",
    "government",
    "civic-tech",
    "civiq",
    "peer-comparison",
    "confidence-score"
  ]
