{
  "name": "@civiq/sdk",
  "version": "0.1.0",
  "description": "TypeScript client for the CIV.IQ civic data API — representatives, bills, votes, committees, intelligence analysis",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build && npm run test"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  },
  "license": "MIT",
  "author": "Mark Sandford",
  "homepage": "https://github.com/civdotiq/civ.iq/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/civdotiq/civ.iq/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/civdotiq/civ.iq.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "civic",
    "government",
    "congress",
    "api",
    "sdk",
    "representatives",
    "legislation",
    "civic-tech",
    "civiq",
    "campaign-finance",
    "voting-records"
  ]
}
