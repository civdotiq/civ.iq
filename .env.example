# Civic Intel Hub - Environment Variables Template
# Copy this file to .env.local and replace dummy values with your actual API keys

# =============================================================================
# Required API Keys for Full Functionality
# =============================================================================

# Congress.gov API Key (REQUIRED for bills, votes, and member data)
# Get your free API key at: https://api.congress.gov/sign-up/
# Documentation: https://github.com/LibraryOfCongress/api.congress.gov
CONGRESS_API_KEY=your_congress_api_key_here

# FEC API Key (REQUIRED for campaign finance data)
# Get your free API key at: https://api.open.fec.gov/developers/
# Documentation: https://api.open.fec.gov/developers/
FEC_API_KEY=your_fec_api_key_here

# OpenStates API Key (REQUIRED for state legislature data)
# Get your free API key at: https://openstates.org/accounts/profile/
# Documentation: https://docs.openstates.org/api-v3/
OPENSTATES_API_KEY=your_openstates_api_key_here

# US Census Bureau API Key (REQUIRED for demographic and district data)
# Get your free API key at: https://api.census.gov/data/key_signup.html
# Documentation: https://www.census.gov/data/developers/guidance/api-user-guide.html
CENSUS_API_KEY=your_census_api_key_here

# =============================================================================
# Optional Configuration
# =============================================================================

# =============================================================================
# Redis/Cache Configuration (Optional - improves performance)
# =============================================================================
#
# CIV.IQ supports three caching modes:
# 1. Upstash Redis REST API (RECOMMENDED for production/serverless)
# 2. Traditional Redis via ioredis (Good for development/dedicated servers)
# 3. In-memory fallback (Automatic if no Redis configured)
#
# See docs/architecture/CACHE_ARCHITECTURE.md for details

# Option 1: Upstash Redis REST API (Recommended for Vercel/serverless)
# Get free account at: https://upstash.com/
# Benefits: HTTP-based, no persistent connections, serverless-optimized
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# Option 2: Traditional Redis (Alternative for development)
# Leave blank to skip traditional Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# OpenAI API Key (Optional - legacy fallback for AI bill summaries)
# Get your API key at: https://platform.openai.com/api-keys
# Note: This feature works without the key using fallback summaries
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini AI (RECOMMENDED - free tier: 250 req/day Flash, 1000 req/day Flash-Lite)
# Get your free API key at: https://aistudio.google.com/apikey
# This is now the primary AI provider. OpenAI above serves as fallback.
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# AI model selection (optional, defaults to gemini-2.0-flash)
# Options: gemini-2.0-flash (best quality), gemini-2.0-flash-lite (higher rate limits)
# AI_MODEL=gemini-2.0-flash

# =============================================================================
# Application Configuration
# =============================================================================

# Environment (development, staging, production)
NODE_ENV=development

# Application URL (used for internal API calls)
# In production, set this to your actual domain
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Congressional Session Configuration (119th Congress - 2025-2027)
CURRENT_CONGRESS=119
CONGRESS_START_DATE=2025-01-03
CONGRESS_END_DATE=2027-01-03

# Enable/disable certain features
ENABLE_ANALYTICS=false
ENABLE_ERROR_REPORTING=false

# FollowTheMoney.org API (Optional - state campaign finance data)
# Get your free API key at: https://www.followthemoney.org/our-data/apis
# Note: This feature works without the key - returns empty finance data gracefully
FOLLOWTHEMONEY_API_KEY=your_followthemoney_api_key_here

# =============================================================================
# Nostr Publishing (Optional - publishes civic events to the Nostr network)
# =============================================================================

# Nostr private key (64-char hex). Generate one:
#   node -e "const{generateSecretKey,getPublicKey}=require('nostr-tools/pure');const sk=generateSecretKey();console.log(Array.from(sk).map(b=>b.toString(16).padStart(2,'0')).join(''))"
# If not set, the Nostr publisher cron runs but publishes nothing.
# NOSTR_PRIVATE_KEY=

# Comma-separated relay WebSocket URLs (optional, defaults to 7 public relays)
# NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.nostr.band

# GovInfo API Key (Optional - used by Nostr publisher for hearing detection)
# Default: DEMO_KEY (40 req/hr). Get a key at: https://api.govinfo.gov/docs
# GOVINFO_API_KEY=your_govinfo_api_key_here

# =============================================================================
# Third-party Services (No API keys required)
# =============================================================================

# The following services work without API keys:
# - GDELT Project API (news data)
# - Census.gov geocoding API
# - GitHub congress-legislators repository
# - PMTiles for district boundaries
# - Census TIGERweb (state legislative district boundaries)

# =============================================================================
# Cache Warming Configuration
# =============================================================================

# Secret token for cache warming endpoint (prevents unauthorized cache busting)
# Generate a secure random token: openssl rand -base64 32
CACHE_WARM_SECRET=your_secure_random_token_here

# Base URL for cache warming (set to your production domain in production)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# =============================================================================
# Development Notes
# =============================================================================

# 1. All API keys are free to obtain from government sources
# 2. Rate limits are generous for civic engagement applications
# 3. Fallback data is provided when APIs are unavailable
# 4. No sensitive user data is stored or transmitted
# 5. All API communications use HTTPS