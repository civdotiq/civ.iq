{
  "name": "civic-intel-hub",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "author": "Mark Sandford",
  "license": "Apache-2.0",
  "overrides": {
    "tar": "^7.5.22",
    "postcss": "$postcss",
    "node-gyp": "^11",
    "adm-zip": "^0.6.0",
    "sharp": "^0.35.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "seed-data": "tsx scripts/seed-congress-data.ts",
    "sync:bioguide-fec": "tsx scripts/sync-bioguide-fec.ts",
    "sync:openstates-people": "tsx scripts/sync-openstates-people.ts",
    "snapshot:adoption": "tsx scripts/snapshot-adoption.ts",
    "start": "next start",
    "stats": "tsx scripts/stats.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "test": "jest",
    "test:watch": "vitest watch",
    "test:unit": "jest",
    "test:unit:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:smoke": "RUN_SMOKE_TESTS=1 jest --testPathPatterns=smoke.integration --runInBand --testTimeout=60000",
    "test:llm-eval": "tsx scripts/llm-eval.ts",
    "test:causation-eval": "tsx scripts/causation-eval.ts",
    "smoke:embedding": "tsx scripts/smoke-embedding-pipeline.ts",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "clean": "rm -rf .next node_modules",
    "clean:install": "npm run clean && npm install",
    "process-census": "tsx scripts/process-census-data.ts",
    "validate-mappings": "tsx scripts/validate-mappings.ts",
    "lookup-zip": "tsx scripts/lookup-zip.ts",
    "complete-phase": "tsx scripts/complete-phase.ts",
    "test-phase3-integration": "tsx scripts/test-phase3-integration.ts",
    "process-district-boundaries": "node scripts/process-district-boundaries.mjs",
    "process-real-census-districts": "node scripts/process-real-census-districts.mjs",
    "process:state-districts": "node scripts/process-state-legislative-districts.mjs",
    "process:mobile-pmtiles": "node scripts/generate-mobile-pmtiles.mjs",
    "test-district-accuracy": "node scripts/test-district-accuracy.mjs",
    "migrate:119th": "npx tsx src/scripts/migrate-119th.ts",
    "validate:data": "npx tsx src/scripts/validate-data.ts",
    "validate-districts": "npx tsx scripts/validate-data.ts",
    "validate:all": "node scripts/validation/validate-all.js",
    "generate-district-neighbors": "tsx scripts/generate-district-neighbors.ts",
    "process-election-data": "tsx scripts/process-election-data.ts",
    "diagnose:apis": "tsx scripts/diagnose-apis.ts",
    "diagnose:fec": "node scripts/diagnose-fec.js",
    "generate:embeddings": "tsx scripts/generate-sector-embeddings.ts",
    "collect:training-data": "DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config scripts/collect-training-data.ts",
    "warm:intelligence": "tsx scripts/warm-intelligence-cache.ts",
    "security:audit": "npm audit --audit-level=high || echo '\\n[security:audit] High or critical advisories found — see above. Non-blocking here; the weekly Security Audit workflow opens an issue for these.'",
    "security:audit:ci": "npm audit --audit-level=high",
    "security:full": "npm run security:audit",
    "security:emergency": "npm audit fix --force",
    "prepare": "husky",
    "test:performance": "node scripts/performance-test.mjs",
    "test:performance:quick": "node scripts/quick-performance-baseline.mjs",
    "test:load": "node scripts/load-test.mjs",
    "test:redis": "tsx scripts/test-redis-performance.ts",
    "validate:production": "tsx scripts/run-production-validation.ts",
    "validate:production:critical": "tsx scripts/run-production-validation.ts -- --critical-only",
    "validate:production:parallel": "tsx scripts/run-production-validation.ts -- --parallel",
    "perf:benchmark": "PERF_LOGGING=true tsx scripts/performance-benchmark.ts",
    "perf:analyze": "node scripts/analyze-bundle.mjs",
    "perf:report": "tsx -e \"const {metricsCollector} = require('./src/lib/performance/metrics-collector'); console.log(metricsCollector.generateReport())\"",
    "perf:baseline": "npm run perf:benchmark && mv performance-results-*.json performance-baseline.json"
  },
  "dependencies": {
    "@ai-sdk/google": "3.0.29",
    "@heroicons/react": "2.2.0",
    "@huggingface/transformers": "4.1.0",
    "@modelcontextprotocol/sdk": "1.26.0",
    "@types/d3": "^7.4.3",
    "@types/js-yaml": "4.0.9",
    "@upstash/ratelimit": "2.0.7",
    "@upstash/redis": "1.35.8",
    "@vercel/analytics": "2.0.1",
    "ai": "6.0.90",
    "autoprefixer": "^10.4.21",
    "cli-progress": "3.12.0",
    "clsx": "^2.1.1",
    "csv-parse": "6.1.0",
    "d3": "^7.9.0",
    "fast-xml-parser": "5.8.0",
    "fuse.js": "7.1.0",
    "ioredis": "^5.6.1",
    "isomorphic-dompurify": "2.16.0",
    "js-yaml": "4.3.1",
    "jszip": "3.10.1",
    "limiter": "3.0.0",
    "lucide-react": "^0.525.0",
    "maplibre-gl": "5.7.0",
    "mcp-handler": "1.1.0",
    "next": "16.2.12",
    "nostr-tools": "2.23.1",
    "pmtiles": "4.3.0",
    "qrcode.react": "4.2.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-window": "1.8.11",
    "recharts": "3.2.0",
    "resend": "6.12.4",
    "rss-parser": "3.13.0",
    "simple-statistics": "7.8.8",
    "swr": "2.3.4",
    "tailwind-merge": "^3.3.1",
    "ws": "8.21.0",
    "zod": "4.1.11",
    "zustand": "5.0.6"
  },
  "devDependencies": {
    "@eslint/compat": "2.0.0",
    "@eslint/eslintrc": "3.3.1",
    "@mapbox/mbtiles": "0.12.1",
    "@mapbox/vector-tile": "2.0.4",
    "@playwright/test": "1.57.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "15.0.7",
    "@testing-library/user-event": "^14.6.1",
    "@types/cli-progress": "3.11.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/papaparse": "5.3.16",
    "@types/pbf": "3.0.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/react-window": "1.8.8",
    "@types/supertest": "^6.0.3",
    "@types/ws": "8.18.1",
    "audit-ci": "^7.1.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "17.2.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.3",
    "glob": "^11.0.0",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "jest": "^30.0.4",
    "jest-environment-jsdom": "^30.0.4",
    "lint-staged": "15.5.2",
    "mapshaper": "0.6.111",
    "msw": "^2.10.3",
    "npm-audit-resolver": "^3.0.0-RC.0",
    "papaparse": "5.5.3",
    "pbf": "4.0.1",
    "postcss": "^8.5.6",
    "prettier": "3.6.2",
    "supertest": "^7.1.1",
    "tailwindcss": "^3.4.1",
    "terser-webpack-plugin": "5.3.17",
    "tsx": "4.20.5",
    "typescript": "5.8.3",
    "vitest": "4.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,scss}": [
      "prettier --write"
    ]
  }
}
